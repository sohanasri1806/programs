#include <stdio.h>
#include <ctype.h>

char p[6][10] = {
    "E=E+T",
    "E=T",
    "T=T*F",
    "T=F",
    "F=(E)",
    "F=id"
};

void first(char c)
{
    int i;
    char x;

    if (!isupper(c))
    {
        printf("%c ", c);
        return;
    }

    for (i = 0; i < 6; i++)
    {
        if (p[i][0] == c)
        {
            x = p[i][2];

            if (x == c)
                x = p[i][3];

            if (x == '(')
                printf("( ");

            else if (x == 'i')
                printf("id ");

            else if (isupper(x))
                first(x);
        }
    }
}

int main()
{
    printf("FIRST(E) = { ");
    first('E');
    printf("}\n");

    printf("FIRST(T) = { ");
    first('T');
    printf("}\n");

    printf("FIRST(F) = { ");
    first('F');
    printf("}\n");

    return 0;
}
