#include <stdio.h>
#include <string.h>

char input[100];
int i = 0;
int error = 0;

void E();
void T();
void F();

void E()
{
    T();

    while(input[i] == '+')
    {
        i++;
        T();
    }
}

void T()
{
    F();

    while(input[i] == '*')
    {
        i++;
        F();
    }
}

void F()
{
    if(input[i] == 'a')
    {
        i++;
    }
    else if(input[i] == '(')
    {
        i++;
        E();

        if(input[i] == ')')
            i++;
        else
            error = 1;   // Missing closing bracket
    }
    else
    {
        error = 1;       // Invalid symbol
    }
}

int main()
{

    printf("Enter expression: ");
    scanf("%s", input);

    E();

    if(error == 0 && input[i] == '\0')
        printf("Valid Expression\n");
    else
        printf("Invalid Expression\n");

    return 0;
}
