Lex program to count characters, tabs, spaces and reserved words
%{
#include <stdio.h>

int characters = 0;
int tabs = 0;
int spaces = 0;
int reserved = 0;
%}

%%

"int"|"float"|"char"|"double"|"if"|"else"|"while"|"for"|"return"|"void"|"break"|"switch"|"case"|"do"|"continue"
    {
        reserved++;
        characters += yyleng;
    }

\t      { tabs++; characters++; }
" "     { spaces++; characters++; }
\n      ;
.       { characters++; }

%%

int yywrap()
{
    return 1;
}

int main()
{
    printf("Enter input:\n");
    yylex();

    printf("\nCharacters = %d", characters);
    printf("\nTabs = %d", tabs);
    printf("\nSpaces = %d", spaces);
    printf("\nReserved words = %d\n", reserved);

    return 0;
}

