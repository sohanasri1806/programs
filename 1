Follow set
#include <stdio.h>

char FOLLOW_E[10];
char FOLLOW_T[10];
char FOLLOW_F[10];

int e = 0, t = 0, f = 0;

void add(char set[], int *n, char c)
{
    int i;

    for(i = 0; i < *n; i++)
    {
        if(set[i] == c)
            return;
    }

    set[*n] = c;
    (*n)++;
}

void follow()
{
    int i;

    // FOLLOW(E)
    add(FOLLOW_E, &e, '$');
    add(FOLLOW_E, &e, ')');
    add(FOLLOW_E, &e, '+');

    // FOLLOW(T)
    add(FOLLOW_T, &t, '*');

    // Add FOLLOW(E) to FOLLOW(T)
    for(i = 0; i < e; i++)
        add(FOLLOW_T, &t, FOLLOW_E[i]);

    // Add FOLLOW(T) to FOLLOW(F)
    for(i = 0; i < t; i++)
        add(FOLLOW_F, &f, FOLLOW_T[i]);
}

void display(char name, char set[], int n)
{
    int i;

    printf("FOLLOW(%c) = { ", name);

    for(i = 0; i < n; i++)
        printf("%c ", set[i]);

    printf("}\n");
}

int main()
{
    follow();

    printf("FOLLOW SETS:\n");

    display('E', FOLLOW_E, e);
    display('T', FOLLOW_T, t);
    display('F', FOLLOW_F, f);

    return 0;
}

